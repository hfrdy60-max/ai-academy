# ============================================================
# AI ACADEMY - example configuration (PLACEHOLDERS ONLY)
# Never put real keys in this file or commit real keys to GitHub.
# ============================================================

# ---- WORKER SECRETS (set with: npx wrangler secret put NAME) ----
# For local testing only, copy to worker/.dev.vars (that file is git-ignored).
OPENROUTER_API_KEY=PLACEHOLDER_do_not_put_a_real_key_here
GEMINI_API_KEY=PLACEHOLDER_optional
SEARCH_API_KEY=PLACEHOLDER_optional_web_search_provider
ACCESS_TOKEN=PLACEHOLDER_optional_shared_access_token

# ---- WORKER PUBLIC SETTINGS (go in worker/wrangler.toml [vars]) ----
ALLOWED_ORIGIN=https://YOUR-USER.github.io

# ---- FRONTEND (public, NOT secret: only the Worker URL) ----
# Create frontend/.env.local with this line. NEVER put an API key in a VITE_ variable.
VITE_WORKER_URL=https://ai-academy-api.YOUR-SUBDOMAIN.workers.dev

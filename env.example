# ============================================================
# AI ACADEMY - example configuration (PLACEHOLDERS ONLY)
# Never put real keys in this file or commit real keys to GitHub.
# ============================================================

# ---- WORKER SECRETS (set with: npx wrangler secret put NAME) ----
# For local testing only, put them in worker/.dev.vars (that file is git-ignored).
OPENROUTER_API_KEY=PLACEHOLDER_your_openrouter_key
ACCESS_TOKEN=PLACEHOLDER_long_random_string_REQUIRED   # the Worker refuses to run without it

# ---- WORKER PUBLIC SETTINGS (worker/wrangler.toml [vars], or .dev.vars for local runs) ----
ALLOWED_ORIGIN=https://YOUR-USER.github.io              # local dev: http://localhost:5173
RATE_LIMIT_PER_MINUTE=30
# MODEL_DEFAULT=PLACEHOLDER_openrouter_model_id
# MODEL_LESSON= / MODEL_CHAT= / MODEL_CHECK= / MODEL_OUTLINE=

# ---- FRONTEND (optional, public, NOT secret) ----
# frontend/.env.local - only the Worker address. The same address can be typed in the app's
# Settings page instead. NEVER put an API key or token in a VITE_ variable.
VITE_WORKER_URL=https://ai-academy-api.YOUR-SUBDOMAIN.workers.dev
